// Orthotopy Store — work publishing catalog
// A Work is anything a developer or creator publishes: an app, a tool,
// a music pack, a design kit, an essay, a photo series.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Work {
  id        String   @id @default(cuid())
  title     String
  tagline   String
  // "Developer" or "Creator"
  kind      String
  category  String
  creator   String
  // key into the shared icon map, e.g. "code", "music"
  icon      String
  // tailwind gradient classes, e.g. "from-emerald-500 to-teal-600"
  gradient  String
  createdAt DateTime @default(now())
}
