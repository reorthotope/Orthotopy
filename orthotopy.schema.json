{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reorthotope/Orthotopy/blob/main/orthotopy.schema.json",
  "title": "Orthotopy catalog entry",
  "description": "Schema for one app entry in catalog/catalog.json. See README for the full submission guide.",
  "type": "object",
  "required": ["id", "name", "tagline", "category", "repo", "developer", "platforms", "install"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 48,
      "description": "Stable unique identifier, lowercase kebab-case."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "tagline": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1200 },
    "category": {
      "type": "string",
      "enum": ["apps", "games", "utilities", "productivity", "multimedia", "communication", "developer-tools"]
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "GitHub repository as owner/name. Releases in this repo are the distribution channel."
    },
    "developer": {
      "type": "object",
      "required": ["name", "handle"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "handle": { "type": "string", "maxLength": 60, "description": "GitHub user or organization login; also groups apps into a creator." }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["android", "ios", "windows", "macos", "linux", "web"] }
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 32 }
    },
    "website": { "type": "string", "format": "uri" },
    "latestVersion": { "type": "string", "maxLength": 40 },
    "releasedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "install": {
      "type": "object",
      "required": ["targets"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["platform"],
            "additionalProperties": false,
            "properties": {
              "platform": { "type": "string", "enum": ["android", "ios", "windows", "macos", "linux", "web"] },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Stable direct download, e.g. https://github.com/owner/repo/releases/latest/download/app.apk (always resolves to the newest asset with this exact name)."
              },
              "assetRegex": {
                "type": "string",
                "description": "Regular expression matched (in order) against the asset names of the latest release; the first match is opened for download. Use this when asset names embed a version number."
              }
            },
            "oneOf": [
              { "required": ["url"] },
              { "required": ["assetRegex"] }
            ]
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stars": { "type": "integer", "minimum": 0 },
        "downloads": { "type": "integer", "minimum": 0 }
      },
      "description": "Snapshot maintained by maintainers/scripts; trending is computed from these."
    }
  }
}
